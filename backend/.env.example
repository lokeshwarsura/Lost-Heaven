# ==========================================
# ClipShip AI Studio - Environment Configuration
# ==========================================

# Google Gemini API Configuration (Creative Director)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_ANALYSIS_MODE=transcript
AUTO_FALLBACK_OFFLINE=True

# Whisper Model Configuration (Local Transcriber)
# Options: tiny, base, small, medium, large-v3-turbo, large-v3
WHISPER_MODEL=large-v3-turbo
# Device options: auto, cuda, cpu
WHISPER_DEVICE=auto
# Compute type options: auto, float16, int8, int8_float16
WHISPER_COMPUTE_TYPE=auto

# Server & Storage Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
STORAGE_DIR=storage

# YouTube OAuth Configuration (YouTube Shorts Publisher)
# Path to client_secrets.json downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# Hardware Acceleration for Video Rendering
# Options: auto (detects nvenc/videotoolbox), nvenc, videotoolbox, cpu
HARDWARE_ACCELERATION=auto
